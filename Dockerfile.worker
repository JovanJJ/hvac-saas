# syntax=docker/dockerfile:1
FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
WORKDIR /app
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/opt/chromium
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && node node_modules/playwright-core/cli.js install --with-deps chromium && rm -rf /var/lib/apt/lists/* /root/.npm
COPY tsconfig.json ./
COPY src/worker ./src/worker
COPY features/reports ./features/reports
COPY features/evidence/model.ts features/evidence/report-photo.ts features/evidence/photo-gallery.tsx ./features/evidence/
COPY features/visits/model.ts ./features/visits/model.ts
COPY lib/cloudinary-settings.ts ./lib/cloudinary-settings.ts
COPY lib/supabase/database.types.ts lib/supabase/settings.ts ./lib/supabase/
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s CMD node -e "const fs=require('fs');if(Date.now()-Number(fs.readFileSync('/tmp/report-worker-health','utf8'))>180000)process.exit(1)"
CMD ["node", "--import", "tsx", "src/worker/main.ts"]
