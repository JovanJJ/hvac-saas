# Add these to the EXISTING Supabase project's private .env, not to browser/runtime config.
# This example uses Gmail as sender. Any recipient email domain can receive confirmation.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@gmail.com
# A Google App Password, not the normal Google Account password.
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Teren
