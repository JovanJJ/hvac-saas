# Add these to the EXISTING Supabase project's private .env, not to browser/runtime config.
# Gmail sender example; never put real credentials in this tracked example file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@gmail.com
# Google App Password without display-grouping spaces, not the normal account password.
SMTP_PASS=REPLACE_WITH_NEW_APP_PASSWORD
SMTP_ADMIN_EMAIL=sender@gmail.com
SMTP_SENDER_NAME=Teren
