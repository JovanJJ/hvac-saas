# Operator-only container on the staging private backend network. Never copy into app/worker files.
DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@db:5432/postgres
STORAGE_ADMIN_DATABASE_URL=postgresql://supabase_admin:PASSWORD@db:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://api-staging.example.invalid
SUPABASE_INTERNAL_URL=http://supabase-api:8000
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_REAL_PUBLIC_KEY
APP_URL=https://staging.example.invalid
CLOUDINARY_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE
# Provisioners persist the generated matching verifier / worker settings to this private mounted file.
EVIDENCE_VERIFICATION_SECRET=
REPORT_WORKER_EMAIL=
REPORT_WORKER_PASSWORD=
