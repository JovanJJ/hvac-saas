{
  "name": "hvac-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:staff-ui": "node scripts/test-staff-ui.mjs",
    "demo:leads": "node scripts/demo-leads.mjs",
    "test:demo-db": "node scripts/test-demo-requests.mjs",
    "sample:workflow": "CAPTURE_PUBLIC_WORKFLOW=true playwright test tests/capture-public-workflow.spec.ts --project=desktop --workers=1",
    "sample:report": "tsx scripts/generate-public-report.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:container": "node scripts/smoke-container.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:visit-api": "node scripts/test-visit-api.mjs",
    "evidence:configure": "node scripts/configure-evidence.mjs",
    "mail:start": "node scripts/start-local-mail.mjs",
    "test:signup": "TEST_LOCAL_MAIL=true playwright test tests/signup-mail.spec.ts",
    "worker:configure": "node scripts/configure-report-worker.mjs",
    "worker:reports": "tsx --env-file=.env src/worker/main.ts",
    "test:worker-container": "tsx --env-file=.env scripts/test-report-worker-container.ts",
    "offline:build": "node scripts/build-offline-shell.mjs",
    "predev": "npm run offline:build",
    "prebuild": "npm run offline:build",
    "pretypecheck": "npm run offline:build",
    "pretest:e2e": "npm run offline:build",
    "worker:maintenance": "tsx --env-file=.env src/worker/main.ts --maintenance-only",
    "mail:external": "node scripts/configure-external-mail.mjs",
    "mail:external:check": "node scripts/configure-external-mail.mjs --check"
  },
  "dependencies": {
    "@next/env": "16.4.6",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "cloudinary": "2.10.0",
    "fflate": "0.8.3",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "playwright-core": "1.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.23.1"
  }
}
