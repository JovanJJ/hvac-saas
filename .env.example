# Public Supabase gateway and client key (publishable, or legacy anon key).
# Copy values from your existing self-hosted stack. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# Optional server/worker-only private API URL.
# SUPABASE_INTERNAL_URL=http://supabase-api:8000
SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application origin for cookies/email redirects and public canonical/social metadata.
# HTTPS in production. Set it at build time AND runtime; Docker uses --build-arg APP_URL.
# NEXT_PUBLIC_SITE_ORIGIN is derived by Next config; do not add a separate key.
APP_URL=http://localhost:3000

# Server-only SQL tooling. Runtime requests use Supabase with the user's session.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Cloudinary authenticated images. Individual settings or a valid cloudinary:// URL; server-only.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# Provision the matching private database verifier with npm run evidence:configure.
# Never expose this key to browsers or use a different value from the target database.
EVIDENCE_VERIFICATION_SECRET=

# Development seeds only. Opt in explicitly; existing fixtures are never overwritten.
# ALLOW_DEVELOPMENT_SEED=true
# SEED_PASSWORD=SET_A_LOCAL_RANDOM_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Set automatically by npm run mail:start; development UI only.
# LOCAL_AUTH_INBOX_URL=http://localhost:9000

# Dedicated non-staff Auth identity, generated by npm run worker:configure.
# Never reuse a staff password or pass DATABASE_URL / service-role keys to the worker.
REPORT_WORKER_EMAIL=
REPORT_WORKER_PASSWORD=
# Docker must reach the same Supabase API; for a host-local API, for example:
# REPORT_WORKER_SUPABASE_URL=http://host.docker.internal:8000
# Provisioning only, optional alternative to local Docker supabase_admin socket:
# STORAGE_ADMIN_DATABASE_URL=
# Test cleanup only, optional alternative to local Docker Storage SERVICE_KEY discovery:
# STORAGE_MAINTENANCE_KEY=
